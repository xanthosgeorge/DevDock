<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:DevDock.Desktop.ViewModels" xmlns:v="using:DevDock.Desktop.Views" x:Class="DevDock.Desktop.Views.MainWindow" x:DataType="vm:MainWindowViewModel" Title="DevDock" Width="1400" Height="900" MinWidth="1100" MinHeight="700" Background="{DynamicResource BackgroundBrush}">
  <Grid>
    <Grid ColumnDefinitions="208,*" IsEnabled="{Binding !IsDialogOpen}">
      <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
        <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" Margin="16,28,16,16">
          <StackPanel Margin="8,0,0,30" Spacing="10">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Path Data="M 18,0 L 36,10 L 36,30 L 18,40 L 0,30 L 0,10 Z M 0,10 L 18,20 L 36,10 M 18,20 L 18,40" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" Fill="{DynamicResource SelectedBrush}" Width="32" Height="36" Stretch="Uniform" />
              <TextBlock Text="DevDock" FontSize="23" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="Local Developer Dashboard" FontSize="10" Foreground="{DynamicResource MutedBrush}" />
          </StackPanel>
          <ItemsControl Grid.Row="1" ItemsSource="{Binding Navigation}">
            <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:NavigationItemViewModel">
              <Button Classes="nav" Classes.selected="{Binding IsSelected}" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).NavigateCommand}" CommandParameter="{Binding Label}" Margin="0,0,0,5">
                <StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="{Binding Icon}" FontSize="20" Width="23" Foreground="{Binding $parent[Button].Foreground}" /><TextBlock Text="{Binding Label}" VerticalAlignment="Center" Foreground="{Binding $parent[Button].Foreground}" /></StackPanel>
              </Button>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel Grid.Row="3" Spacing="14" Margin="8,16,8,24">
            <TextBlock Text="SYSTEM" Classes="caption" LetterSpacing="2" />
            <Grid ColumnDefinitions="*,Auto"><TextBlock Text="CPU" Classes="muted" /><TextBlock Grid.Column="1" Text="—" Classes="muted" /></Grid>
            <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Memory" Classes="muted" /><TextBlock Grid.Column="1" Text="—" Classes="muted" /></Grid>
            <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Disk" Classes="muted" /><TextBlock Grid.Column="1" Text="—" Classes="muted" /></Grid>
            <TextBlock Text="System metrics are not available yet." Classes="caption" FontSize="10" TextWrapping="Wrap" />
          </StackPanel>
          <Grid Grid.Row="4" ColumnDefinitions="*,Auto"><Button Classes="nav" Content="⚙  Settings" Command="{Binding SettingsCommand}" /><TextBlock Grid.Column="1" Text="v0.3.0" Classes="caption" VerticalAlignment="Center" /></Grid>
        </Grid>
      </Border>
      <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*,Auto" Margin="24,24,24,12">
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,20">
          <StackPanel Spacing="5"><TextBlock Classes="heading" Text="{Binding PageTitle}" /><TextBlock Classes="muted" Text="Your local development environment at a glance." TextWrapping="Wrap" /></StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Top" Margin="16,5,0,0">
            <Button Content="{Binding Dashboard.RefreshLabel}" Command="{Binding Dashboard.RefreshCommand}" />
            <Button Classes="primary" Content="{Binding Dashboard.AddProjectLabel}" Command="{Binding Dashboard.AddProjectCommand}" />
          </StackPanel>
        </Grid>
        <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,16" Margin="0,0,0,18">
          <StackPanel Spacing="8">
            <WrapPanel><TextBlock Text="{Binding Dashboard.ProjectSummary}" Margin="0,0,24,5" /><TextBlock Text="{Binding Dashboard.RunningSummary}" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,24,5" ToolTip.Tip="Projects started by DevDock" /><TextBlock Text="Current session" Classes="muted" /></WrapPanel>
            <ProgressBar IsVisible="{Binding Dashboard.IsScanning}" IsIndeterminate="True" />
          </StackPanel>
        </Border>
        <v:DashboardView Grid.Row="2" />
        <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="0,10,0,0"><TextBlock Text="{Binding Dashboard.Feedback}" Classes="caption" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="1" Text="PROJECT CONTROL · GIT WORKSPACE" Classes="caption" LetterSpacing="1" Margin="12,0,0,0" /></Grid>
      </Grid>
    </Grid>
    <Border IsVisible="{Binding IsDialogOpen}" Background="{DynamicResource OverlayBrush}" IsHitTestVisible="True">
      <Border Classes="panel" Width="440" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28">
        <StackPanel Spacing="18">
          <TextBlock Text="＋" FontSize="32" Foreground="{DynamicResource AccentBrush}" />
          <TextBlock Text="{Binding DialogTitle}" FontSize="23" FontWeight="SemiBold" />
          <TextBlock Text="{Binding DialogMessage}" Classes="muted" TextWrapping="Wrap" LineHeight="23" />
          <Button Classes="primary" Content="Got it" Command="{Binding CloseDialogCommand}" HorizontalAlignment="Right" MinWidth="90" HotKey="Escape" />
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</Window>
