<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DevDock.Desktop.ViewModels" xmlns:m="using:DevDock.Desktop.Models"
        x:Class="DevDock.Desktop.Views.WorkspaceDialogWindow" x:DataType="vm:WorkspaceDialogViewModel"
        Title="{Binding Title}" Width="580" SizeToContent="Height" MaxHeight="620" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{DynamicResource BackgroundBrush}">
  <StackPanel Margin="24" Spacing="18">
    <TextBlock Text="{Binding Title}" FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap" />
    <TextBlock Text="{Binding Description}" Classes="muted" TextWrapping="Wrap" LineHeight="22" />
    <ListBox ItemsSource="{Binding Configurations}" SelectedItem="{Binding SelectedConfiguration}" IsVisible="{Binding IsChoice}" MaxHeight="300">
      <ListBox.ItemTemplate><DataTemplate x:DataType="m:ProjectRunConfiguration">
        <StackPanel Spacing="6" Margin="4,8"><TextBlock Text="{Binding Name}" TextWrapping="Wrap" /><TextBlock Text="{Binding DisplayCommand}" Classes="mono muted" TextWrapping="Wrap" /></StackPanel>
      </DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
      <Button Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True" />
      <Button Classes="primary" Content="{Binding ConfirmLabel}" Command="{Binding ConfirmCommand}" />
    </StackPanel>
  </StackPanel>
</Window>
