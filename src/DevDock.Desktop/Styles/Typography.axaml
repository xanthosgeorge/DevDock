<Styles xmlns="https://github.com/avaloniaui">
  <Style Selector="Window"><Setter Property="FontFamily" Value="Inter, Segoe UI, .AppleSystemUIFont, sans-serif" /><Setter Property="FontSize" Value="13" /><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /></Style>
  <Style Selector="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /></Style>
  <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /></Style>
  <Style Selector="TextBlock.caption"><Setter Property="FontSize" Value="11" /><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /></Style>
  <Style Selector="TextBlock.heading"><Setter Property="FontSize" Value="28" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
  <Style Selector="TextBlock.section"><Setter Property="FontSize" Value="16" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
  <Style Selector="TextBlock.projectName"><Setter Property="FontSize" Value="18" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
  <Style Selector="TextBlock.mono"><Setter Property="FontFamily" Value="Cascadia Code, Consolas, Menlo, monospace" /><Setter Property="FontSize" Value="12" /></Style>
  <Style Selector="SelectableTextBlock.consoleLine"><Setter Property="FontFamily" Value="Cascadia Code, Consolas, Menlo, monospace" /><Setter Property="FontSize" Value="12" /><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /></Style>
  <Style Selector="SelectableTextBlock.consoleLine.error"><Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" /></Style>
</Styles>
